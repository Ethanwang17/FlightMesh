# Copy to .env (git-ignored) to configure the data pipeline locally.

# Contact info (an email address or a URL) added to the User-Agent for Wikipedia/Wikidata.
# Wikimedia allows ~200 requests/min with contact info and only ~10/min without, so a full
# route refresh takes ~40 minutes with it and ~15 hours without.
FLIGHTMESH_CONTACT=

# Where the pipeline keeps its database, cache and reports. Defaults to ./data.
# FLIGHTMESH_DATA_DIR=
